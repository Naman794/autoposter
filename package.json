{
  "name": "threadpilot-autoposter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "publish:due": "node --env-file-if-exists=.env scripts/publish-due.js",
    "publish:check": "node --env-file-if-exists=.env scripts/publish-due.js --dry-run"
  },
  "dependencies": {"mongodb": "^7.0.0"}
}
