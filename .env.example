NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=threadpilot
# At least 12 characters. This is the private owner login, NOT your Reddit password.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Optional until Reddit approves the application. Never commit real values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:threadpilot:v1.0 (by /u/YOUR_REDDIT_USERNAME)
# Defaults off; review your approved queue before enabling on BOTH web and cron services.
ENABLE_AUTOPUBLISH=false
